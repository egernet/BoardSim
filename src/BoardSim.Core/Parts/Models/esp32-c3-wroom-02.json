      "vih": "0.75*VDD"
    },
    "13": {
      "name": "GPIO18",
      "type": "io",
      "maxVolts": 3.6,
      "vih": "0.75*VDD"
    },
    "14": {
      "name": "GPIO19",
      "type": "io",
      "maxVolts": 3.6,
      "vih": "0.75*VDD"
    },
    "15": {
      "name": "GPIO3",
      "type": "io",
      "maxVolts": 3.6,
      "vih": "0.75*VDD"
    },
    "16": {
      "name": "GPIO2",
      "type": "io",
      "maxVolts": 3.6,
      "vih": "0.75*VDD",
      "strap": "high",
      "why": "GPIO2 is a strapping pin and should be high at reset."
    },
    "17": {
      "name": "GPIO1",
      "type": "io",
      "maxVolts": 3.6,
      "vih": "0.75*VDD"
    },
    "18": {
      "name": "GPIO0",
