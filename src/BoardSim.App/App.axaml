<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BoardSim.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0f1115"/>
    <SolidColorBrush x:Key="Panel" Color="#151920"/>
    <SolidColorBrush x:Key="Panel2" Color="#1b2029"/>
    <SolidColorBrush x:Key="Line" Color="#262c37"/>
    <SolidColorBrush x:Key="Text" Color="#e6e9ef"/>
    <SolidColorBrush x:Key="Muted" Color="#8b93a1"/>
    <SolidColorBrush x:Key="Accent" Color="#3bd1ff"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#ff5c5c"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#ffb547"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#6ca0ff"/>
    <SolidColorBrush x:Key="OkBrush" Color="#41d98a"/>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="LetterSpacing" Value="0.8"/>
    </Style>

    <!-- Toolbar buttons -->
    <Style Selector="Button.tool, ToggleButton.tool">
      <Setter Property="Background" Value="#1b2029"/>
      <Setter Property="BorderBrush" Value="#2a313d"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#232a35"/>
      <Setter Property="BorderBrush" Value="#3a4352"/>
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#16384a"/>
      <Setter Property="BorderBrush" Value="#3bd1ff"/>
      <Setter Property="Foreground" Value="#e6f8ff"/>
    </Style>
    <Style Selector="ToggleButton.tool.sim:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#123522"/>
      <Setter Property="BorderBrush" Value="#41d98a"/>
    </Style>
    <Style Selector="ToggleButton.seg">
      <Setter Property="Padding" Value="9,3"/>
      <Setter Property="MinWidth" Value="34"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Background" Value="#202631"/>
      <Setter Property="BorderBrush" Value="#2f3744"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleButton.seg.hi:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#5a3a08"/>
      <Setter Property="BorderBrush" Value="#ffb21e"/>
      <Setter Property="Foreground" Value="#ffe2a8"/>
    </Style>
    <Style Selector="ToggleButton.seg.lo:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#0f2a5c"/>
      <Setter Property="BorderBrush" Value="#2f7bff"/>
      <Setter Property="Foreground" Value="#cfe0ff"/>
    </Style>
    <Style Selector="ToggleButton.seg.in:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#2a313d"/>
      <Setter Property="BorderBrush" Value="#8b93a1"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3bd1ff"/>
      <Setter Property="Foreground" Value="#06202b"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,7"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#6fe0ff"/>
      <Setter Property="Foreground" Value="#06202b"/>
    </Style>

    <!-- Lists -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#16303d"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1c232d"/>
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="10,0"/>
    </Style>
  </Application.Styles>
</Application>
